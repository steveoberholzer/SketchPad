<Window x:Class="Sketchpad.App.Html.HtmlImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Import from HTML" Height="600" Width="900"
        MinHeight="420" MinWidth="620"
        Background="#F8F8F6"
        WindowStartupLocation="CenterOwner">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="#F0F0EE"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="Import from HTML" FontSize="15" FontWeight="SemiBold" Foreground="#2A2A2A"/>
                <TextBlock FontSize="11" Foreground="#777777" Margin="0,2,0,0">
                    Paste simple HTML on the left — the Sketchpad DSL appears on the right as you type.
                    Headings become cards, tables with inputs become rows, data tables become grids.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Bottom bar -->
        <Border DockPanel.Dock="Bottom"
                Background="#F0F0EE"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           FontSize="11" Foreground="#777777"
                           Text="Paste or type HTML on the left."/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="InsertButton"
                            Content="Insert into Editor"
                            IsEnabled="False"
                            Click="Insert_Click"
                            Padding="14,6" Margin="0,0,8,0"
                            FontSize="12"/>
                    <Button Content="Close"
                            Click="Close_Click"
                            Padding="14,6"
                            FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Split: HTML editor | DSL preview -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- HTML input -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top"
                        Padding="12,6"
                        Background="#F8F8F6"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="HTML:" FontSize="12" Foreground="#555555"/>
                </Border>
                <TextBox x:Name="HtmlBox"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Padding="8"
                         Background="#FAFAF8"
                         TextChanged="HtmlBox_TextChanged"/>
            </DockPanel>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#CCCCCC"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- DSL preview -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top"
                        Padding="12,6"
                        Background="#F8F8F6"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1,0,0,1">
                    <TextBlock Text="Sketchpad DSL:" FontSize="12" Foreground="#555555"/>
                </Border>
                <avalon:TextEditor x:Name="DslPreview"
                                   IsReadOnly="True"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   ShowLineNumbers="True"
                                   WordWrap="False"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   Padding="8"
                                   Background="#FAFAF8"/>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
